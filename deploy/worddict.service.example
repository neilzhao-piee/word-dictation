[Unit]
Description=Word Dictation Helper (听写小助手)
After=network-online.target

[Service]
Type=exec
User=worddict
WorkingDirectory=/opt/word-dictation
Environment=WD_DATA_DIR=/opt/word-dictation/data
ExecStart=/opt/word-dictation/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
